server:
  port: 2222

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/projet_chat?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: YOUR_DB_USER
    password: YOUR_DB_PASSWORD
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true

# Remplacer par une clé longue et secrète en local (ne pas committer le vrai fichier)
app:
  jwt:
    secret: CHANGE_ME_TO_A_LONG_RANDOM_SECRET
    expiration-ms: 86400000
