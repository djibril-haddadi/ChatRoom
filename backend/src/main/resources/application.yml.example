server:
  port: 2222

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/projet_chat?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: YOUR_DB_USER
    password: YOUR_DB_PASSWORD
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true

# Use a long random secret locally (do not commit the real application.yml)
app:
  jwt:
    secret: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
    expiration-ms: 86400000
